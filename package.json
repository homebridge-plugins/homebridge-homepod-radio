{
  "name": "@homebridge-plugins/homebridge-homepod-radio",
  "displayName": "Homepod Mini Radio",
  "type": "module",
  "version": "3.2.12",
  "description": "Homebridge accessory for streaming radio to Homepod Mini and Apple TV",
  "author": "Petro Kushchak",
  "license": "MIT",
  "homepage": "https://github.com/homebridge-plugins/homebridge-homepod-radio#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/homebridge-plugins/homebridge-homepod-radio.git"
  },
  "bugs": {
    "url": "https://github.com/homebridge-plugins/homebridge-homepod-radio/issues"
  },
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "plugin",
    "homebridge plugin",
    "homepod",
    "homepod mini",
    "apple tv",
    "stream",
    "audio",
    "radio",
    "airplay",
    "airplay2",
    "pyatv"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc && npm run copy",
    "copy": "cp bin/* dist",
    "e2e": "npm run build && node dist/e2e/test_e2e.js",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "dependencies": {
    "audio-duration-lite": "^1.0.4",
    "homebridge-lib": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^26.0.0",
    "eslint": "^10.0.1",
    "homebridge": "^2.0.0-beta.55",
    "nodemon": "^3.1.9",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.24.1"
  }
}
